{
  "name": "machine-memory-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @machine-memory/backend\" \"npm run dev -w @machine-memory/frontend\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "build": "npm run build --workspaces",
    "db:seed": "node --import tsx scripts/data/seed.ts",
    "demo:reset": "node --import tsx scripts/data/demo-reset.ts",
    "rag:ingest": "node --import tsx scripts/rag/ingest.ts",
    "data:penmanshiel": "node --import tsx scripts/data/import-penmanshiel.ts",
    "rag:ingest:corpus": "node --import tsx scripts/rag/ingest-corpus.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/multer": "^2.2.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "concurrently": "9.2.4",
    "eslint": "9.39.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "dotenv": "17.2.3",
    "groq-sdk": "1.6.0",
    "multer": "2.3.0",
    "pdf-parse": "2.4.5",
    "pg": "8.16.3",
    "zod": "4.1.13"
  }
}
