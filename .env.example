# Backend only; never use VITE_ for secrets. Copy into repository root.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Local browser origins are fixed to localhost/127.0.0.1 on ports 5173 and 3001.
# Supabase session pooler URI from your NEW Machine Memory project
DATABASE_URL=
# Verified TLS required for remote database; optional Supabase CA PEM path
DATABASE_CA_PATH=
# Google AI Studio key for the Gemini free tier. Backend only; never expose via VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dimensions are fixed by migration; do not change without reembedding/migration.
EMBEDDING_DIMENSIONS=1536
# Secondary GENERATION provider only. Groq never produces embeddings: the pgvector corpus is
# gemini-embedding-001, and vectors from different models are not interchangeable. Backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Development override for testing failover: auto (default) | gemini | groq.
AI_GENERATION_PROVIDER=auto
# No-login MVP stays loopback-only. No shared public deployment in phase one.
